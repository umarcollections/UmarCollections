{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix backend --omit=dev && npm ci --prefix client --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "includeFiles": "client/dist/index.html" }
  },
  "routes": [{ "src": "/", "dest": "/api/index" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
