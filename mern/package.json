{
  "name": "mern-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MERN starter: Express + MongoDB API and React (Vite) client with JWT auth",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix client",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:client\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:client": "npm run dev --prefix client",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix backend && npm run lint --prefix client",
    "make-admin": "npm run make-admin --prefix backend --",
    "seed:demo": "npm run seed:demo --prefix backend --",
    "test": "npm test --prefix backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.9"
  }
}
