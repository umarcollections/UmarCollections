PORT=5000
NODE_ENV=development

# Local:  mongodb://127.0.0.1:27017/<db-name>
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/myapp

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Origins allowed by CORS, comma separated (the deployed client URL in production)
CLIENT_URL=http://localhost:5173

# Store owner login for /admin/login. The account is created (or updated to
# this password and the admin role) every time the server starts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Image storage (product photos, payment screenshots). Optional: leave these
# out and the store runs, but photo uploads stay off until they are filled in.
# Free account at https://cloudinary.com, values are on the dashboard under "API Keys".
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# New-order alerts on WhatsApp, through CallMeBot (free). Optional: without
# both values no alerts are sent. To get the key, follow the WhatsApp steps on
# https://www.callmebot.com from the phone that should get the alerts: save
# their number, send it the message they show, and it replies with your key.
# ALERT_WHATSAPP_PHONE=923001234567
# CALLMEBOT_API_KEY=your-callmebot-key

# Emails to customers (order, payment, shipping, password reset) and to the
# owner, sent through Resend (https://resend.com, free plan). Optional: without
# a key no emails are sent. Until a domain is verified in Resend, EMAIL_FROM must
# stay unset (their test sender) and emails only reach the Resend account's own
# address; after verifying, set e.g. EMAIL_FROM=Umar Collections <orders@example.com>
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=Umar Collections <orders@example.com>
# Where owner alerts go (defaults to the store email)
# OWNER_EMAIL=you@example.com

# Public address of the store, with https:// and no trailing slash. Search
# engines are told this is the address to list (canonical links, sitemap, link
# previews), and alerts link to it. Without it Vercel's <project>.vercel.app
# domain is used, so set it whenever people use another address.
# SITE_URL=https://www.example.com

# Set to 1 when running behind a reverse proxy in production (Vercel, Render...)
TRUST_PROXY=0

# Auth cookie. 'lax' works when client and API share a site (same domain or
# subdomains, e.g. app.example.com + api.example.com). Use 'none' only when
# they are on different sites; it requires HTTPS.
COOKIE_SAMESITE=lax
# Defaults to true in production. Set true whenever the API is served over HTTPS.
# COOKIE_SECURE=true
